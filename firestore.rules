rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.phone_number != null;
    }
    function isRoomMember() {
      return signedIn()
        && resource.data.members is list
        && request.auth.token.phone_number in resource.data.members;
    }
    match /users/{uid} {
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.phone == request.auth.token.phone_number;
      allow read, delete: if signedIn() && request.auth.uid == uid;
    }
    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.token.phone_number in request.resource.data.members;
      allow get: if signedIn()
        && resource.data.members is list
        && request.auth.token.phone_number in resource.data.members;
      allow list: if false;
      allow update, delete: if false;
      match /messages/{messageId} {
        function parentRoom() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }
        allow read: if signedIn()
          && request.auth.token.phone_number in parentRoom().members;
        allow create: if signedIn()
          && request.auth.token.phone_number in parentRoom().members
          && request.resource.data.sender == request.auth.token.phone_number
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}